# Copy to .env for local work. Never commit .env.
# On Vercel, set the same names in Project → Settings → Environment Variables.

# --- Database (PostgreSQL / Neon) ------------------------------------------
# Vercel/app queries: Neon *pooled* connection string.
# Include sslmode=require. If the host contains "-pooler", also add pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# prisma migrate deploy: Neon *direct* (non-pooler) connection string.
# Do not put DATABASE_URL or DIRECT_URL in any NEXT_PUBLIC_* variable.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local Docker Postgres (optional, not for Vercel):
# DATABASE_URL="postgresql://knivpojkarna:knivpojkarna@localhost:5432/knivpojkarna?schema=public"
# DIRECT_URL="postgresql://knivpojkarna:knivpojkarna@localhost:5432/knivpojkarna?schema=public"

# --- Admin authentication ---------------------------------------------------
# Generate a unique value: openssl rand -base64 48
# Production MUST use a different value from local development.
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-48"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Optional seed values (also editable later in Admin → Settings)
WHATSAPP_NUMBER=""
CONTACT_EMAIL=""

# Public site URL (canonical tags, sitemap, JSON-LD). Not a secret.
# Local:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Vercel (set this to the real assigned URL after the first deploy):
# NEXT_PUBLIC_SITE_URL="https://knivpojkarna.vercel.app"

# Transactional email (Resend). Leave empty until a mailbox exists.
# Templates are implemented; production sending stays off until both are set.
RESEND_API_KEY=""
EMAIL_FROM=""
